/resources/dicom/

# Python 校验脚本的字节码缓存
__pycache__/
*.py[cod]

# OS / IDE
.DS_Store
.vscode/
.idea/
*.user

# Qt Creator
CMakeLists.txt.user*

# Lume 参考实现的本地 SQLite 库
tools/lume-medmon/.data/

# Lume 参考实现的本地模型配置与自动同步的 skill 缓存（不入库）
tools/lume-medmon/.env
tools/lume-medmon/skills/
