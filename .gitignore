# Build artifacts
/build/
/out/
/cmake-build-*/

# Frontend
frontend/node_modules/
frontend/dist/
# qwebchannel.js 由 vite.config.ts 从 Qt 安装同步，属生成物
frontend/public/qwebchannel.js

# Qt WebEngine 运行数据（缓存/存储）
*.log
resources/web/
!resources/web/.gitkeep

# 样例 DICOM 序列（约 78MB，只留在本地，不入库）
