// tools/lume-medmon/app.lume — 术中桌面壳（qt-react-shell）↔ Lume 事件总线参考实现
//
// 启动：cd tools/lume-medmon && lume app.lume   → http://127.0.0.1:8090
//   GET  /health                 存活探针
//   POST /api/medmon/audit       桌面壳上行审计事件（body: { app, sentAt, events:[…] }）
//   GET  /api/medmon/summary     按类型汇总（给看板/KPI 用）
//   GET  /api/medmon/events      最近事件（?limit=，默认 50，按 id 倒序）
//
// 存储：SQLite（.data/medmon.db，`events` 表一行一条）。不用进程内数组——
// lume 的 run() 每请求 fork，全局数组写在子进程里，GET 读不到（实测
// POST accepted=2 而 summary total=0）。
//
// 边界：这是「参考实现」。生产侧要补：按台次/患者建索引、保留期清理、
// 写侧鉴权（htpasswd 或 X-* 头门禁）。上行协议不变。
//
// 桌面壳侧只需 QTRS_LUME_URL=http://127.0.0.1:8090；本地台账仍是权威。

let medmon_bind = env("LUME_BIND");
if (medmon_bind == null) {
  medmon_bind = "127.0.0.1";
}
let medmon_port = 8090;
let medmon_workers = 2;
let db = ".data/medmon.db";

server {
  port = medmon_port;
  workers = medmon_workers;
  bind = medmon_bind;
};

mkdir(".data");

// 首跑初始化：sql_write 的 open 不带 CREATE，缺文件要先造 0 字节。
func ensure_db() {
  let exists = false;
  for (f in files(".data")) {
    if (f == "medmon.db") {
      exists = true;
    }
  }
  if (not exists) {
    let w = try(() => write_file(db, ""));
    if (w.err != null) {
      print("警告: 无法创建 " + db + ": " + w.err);
      return;
    }
  }
  let ddl = [
    "CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT, ts_us INTEGER, session TEXT, type TEXT, level TEXT, payload TEXT, created INTEGER)"
  ];
  for (s in ddl) {
    let r = try(() => sql_write(db, s));
    if (r.err != null) {
      print("警告: 建表失败: " + r.err);
    }
  }
}
ensure_db();

func body_of(req) {
  if (req.body == null) {
    return { ok: null, err: "缺少 body" };
  }
  let r = try(() => json(req.body));
  if (r.err != null) {
    return { ok: null, err: "body 不是合法 JSON: " + r.err };
  }
  return { ok: r.ok, err: null };
}

get "/health", (req) => {
  return { body: { ok: true, app: "lume-medmon" } };
};

post "/api/medmon/audit", (req) => {
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  let batch = get(b.ok, "events", null);
  if (batch == null) {
    return { status: 400, body: { err: "缺少 events 数组" } };
  }
  let i = 0;
  let accepted = 0;
  while (i < len(batch)) {
    let ev = batch[i];
    let t = get(ev, "type", "");
    // 只收有 type 的事件：type 是整条事件线的锚，缺了它无法统计也无法复核。
    if (t != "") {
      let r = try(() => sql_write(db,
        "INSERT INTO events (ts, ts_us, session, type, level, payload, created) VALUES (?, ?, ?, ?, ?, ?, ?)",
        [get(ev, "ts", ""), int(ev, "tsUs", 0), get(ev, "session", ""), t,
         get(ev, "level", ""), stringify(ev), int(now())]));
      if (r.err != null) {
        return { status: 500, body: { err: r.err, accepted: accepted } };
      }
      accepted = accepted + 1;
    }
    i = i + 1;
  }
  return { body: { ok: true, accepted: accepted } };
};

func count_like(pattern) {
  let r = try(() => sql_query(db, "SELECT COUNT(*) AS n FROM events WHERE type LIKE ?", [pattern]));
  if (r.ok == null) {
    return 0;
  }
  if (len(r.ok) == 0) {
    return 0;
  }
  return int(r.ok[0], "n", 0);
}

get "/api/medmon/summary", (req) => {
  let last = null;
  let r = try(() => sql_query(db, "SELECT payload FROM events ORDER BY id DESC LIMIT 1", []));
  if (r.ok != null and len(r.ok) > 0) {
    let p = try(() => json(get(r.ok[0], "payload", "")));
    if (p.err == null) {
      last = p.ok;
    }
  }
  return {
    body: {
      total: count_like("%"),
      alarm: count_like("alarm.%"),
      session: count_like("session.%"),
      pacs: count_like("pacs.%"),
      watchdog: count_like("watchdog.%"),
      dicom: count_like("dicom.%"),
      lume: count_like("lume.%"),
      last: last
    }
  };
};

get "/api/medmon/events", (req) => {
  let limit = int(req.query_params, "limit", 50);
  if (limit < 1) {
    limit = 1;
  }
  if (limit > 500) {
    limit = 500;
  }
  let out = [];
  let r = try(() => sql_query(db, "SELECT payload FROM events ORDER BY id DESC LIMIT ?", [limit]));
  if (r.ok != null) {
    let i = 0;
    while (i < len(r.ok)) {
      let p = try(() => json(get(r.ok[i], "payload", "")));
      if (p.err == null) {
        out = push(out, p.ok);
      }
      i = i + 1;
    }
  }
  return { body: { events: out } };
};

run();
